# Source this file in the shell or use a host service EnvironmentFile.
# Never commit a populated copy. The application reads environment variables, not dotenv files.
PIPELINE_STATE=/absolute/path/to/Outreach-Agent/state
PIPELINE_GOOGLE_TOKEN=/absolute/path/to/Outreach-Agent/state/google-token.json
NO_AI_SLOP_DIR=/absolute/path/to/the/installed/no-ai-slop
PIPELINE_LLM_BASE_URL=https://your-openai-compatible-provider.example/v1
PIPELINE_LLM_API_KEY=
PIPELINE_MODEL_RESEARCH=
PIPELINE_MODEL_QUALIFY=
PIPELINE_MODEL_CLASSIFY=
PIPELINE_MODEL_WRITE=
PIPELINE_MODEL_EDIT=
PIPELINE_MODEL_GROUND=
PIPELINE_MODEL_PROPOSAL=
PIPELINE_LLM_REQUESTS_PER_MINUTE=30
BRAVE_SEARCH_API_KEY=
